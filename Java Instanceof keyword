import java.util.*;

public class Solution {

    public static String count(ArrayList<Object> myList) {
        int s = 0, r = 0, h = 0;

        for (Object obj : myList) {
            if (obj instanceof Student)
                s++;
            else if (obj instanceof Rockstar)
                r++;
            else if (obj instanceof Hacker)
                h++;
        }

        return s + " " + r + " " + h;
    }
}
